# Minimal zero-dependency development defaults (cp .env.example .env && pnpm dev)
NODE_ENV=development
APP_NAME="Hono OpenAPI Starter"
PORT=9999
LOG_LEVEL=debug
DATABASE_URL=file:dev.db
BETTER_AUTH_SECRET=dev-only-secret-change-before-production
BETTER_AUTH_URL=http://localhost:9999

# Remote Turso / libSQL authentication (required in production for libsql:// and https://)
# DATABASE_AUTH_TOKEN=

# CORS, proxy headers, rate limiting, and SSE limits
# CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=false
# RATE_LIMIT_ENABLED=true
# MAX_SSE_CONNECTIONS=1000

# Redis and BullMQ (optional in development; required in production)
# REDIS_URL=redis://localhost:6379
# CACHE_PREFIX=app

# Worker, observability, and graceful shutdown
# WORKER_EMBEDDED=false
# WORKER_CONCURRENCY=5
# WORKER_SHUTDOWN_TIMEOUT_MS=10000
# WORKER_METRICS_PORT=9091
# METRICS_ENABLED=true
# METRICS_TOKEN=
# READINESS_TIMEOUT_MS=2000
# SHUTDOWN_TIMEOUT_MS=10000
# SHUTDOWN_DRAIN_DELAY_MS=0

# Object storage (defaults to local disk when S3_BUCKET is unset; RustFS/S3 optional)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./.storage
# STORAGE_MAX_FILE_SIZE_BYTES=10485760
# STORAGE_PRESIGN_MAX_FILE_SIZE_BYTES=104857600
# STORAGE_PRESIGN_EXPIRES_SECONDS=900
# STORAGE_SIGNING_SECRET=
# S3_BUCKET=app-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=rustfsadmin
# S3_FORCE_PATH_STYLE=true
