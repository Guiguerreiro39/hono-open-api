{
  "name": "hono-open-api-starter",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_ENV=test vitest run --project unit",
    "test:watch": "cross-env NODE_ENV=test vitest --project unit",
    "test:integration": "cross-env NODE_ENV=test vitest run --project integration",
    "test:coverage": "cross-env NODE_ENV=test vitest run --project unit --coverage",
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:seed": "tsx src/infra/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "@libsql/client": "^0.17.4",
    "@scalar/hono-api-reference": "^0.11.11",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
