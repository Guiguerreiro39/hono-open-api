# Local integration defaults matching docker-compose.yml infra services:
#   docker compose up -d --wait redis s3 s3-init
#
# Unit tests keep REDIS_URL and S3_BUCKET unset in .env.test; tests/integration/env.ts
# exports these same defaults for parseEnv(overrides?) / createTestApp(overrides?).

REDIS_URL=redis://localhost:6379
STORAGE_DRIVER=s3
S3_BUCKET=app-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
